# OpenClaw 适配器配置（开发环境）
#
# 请求链路：
#   HTTP:  前端 /api/v1/* → Vite proxy → 适配器 localhost:3001 → OpenClaw 网关 localhost:18789
#   WS:    前端 /api/v1/ws → Vite proxy → 适配器 localhost:3002 → OpenClaw 网关 ws://localhost:18789/ws
#
# 启动适配器：进入 openclaw-adapter/ 目录，运行 start.bat 或 node server.js

# 使用相对路径，由 Vite proxy 转发至适配器，规避 CORS（保持此值不变）
VITE_OPENCLAW_API_URL=/api/v1
VITE_OPENCLAW_WS_URL=

# OpenClaw 认证令牌（从 openclaw.json 获取）
VITE_OPENCLAW_TOKEN=d35fefbd61c79bac0feedcc07ce68132f38b2c287a2fb439
