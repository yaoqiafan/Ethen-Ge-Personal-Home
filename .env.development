# OpenClaw 网关配置（开发环境）
# dev 模式下使用相对路径，由 Vite proxy 转发至 localhost:18789，规避 CORS
# 若需直连真实网关（需网关已开启 CORS），可改为绝对地址：
#   VITE_OPENCLAW_API_URL=http://localhost:18789/api
#   VITE_OPENCLAW_WS_URL=ws://localhost:18789/ws

VITE_OPENCLAW_API_URL=/api/v1
VITE_OPENCLAW_WS_URL=

# OpenClaw 认证令牌（从 openclaw.json 获取）
VITE_OPENCLAW_TOKEN=d35fefbd61c79bac0feedcc07ce68132f38b2c287a2fb439
