# 腾讯云 COS 配置（与前端 .env.local 中的 VITE_COS_* 值相同，去掉 VITE_ 前缀）
COS_SECRET_ID=your_secret_id
COS_SECRET_KEY=your_secret_key
COS_BUCKET=your_bucket_name
COS_REGION=ap-shanghai

# 推送通知 Key（Bark iOS key 或 Server酱 SCT key）
PUSH_KEY=your_push_key

# 微信订阅消息（工单结束时推送给用户）
# WX_APP_ID 填小程序 AppID，WX_APP_SECRET 在小程序后台「开发 → 开发管理 → 开发设置」中查看
# WX_SUBSCRIBE_TEMPLATE_ID 在小程序后台「功能 → 订阅消息」中选用模板后获得
WX_APP_ID=wx5cbcbaa1e3cb9b70
WX_APP_SECRET=your_app_secret
WX_SUBSCRIBE_TEMPLATE_ID=your_template_id

# 服务监听端口（IIS rewrite 转发目标）
PORT=3004
